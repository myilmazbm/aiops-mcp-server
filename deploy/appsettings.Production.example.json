{
  "Urls": "http://0.0.0.0:5100",
  "Mcp": {
    "AllowedClientIps": [ "<llm-client-ip>" ]
  },
  "Alerts": {
    "AllowedSourceIps": [ "<scom-management-server-ip>" ],
    "ForwardUrl": "",
    "QueueCapacity": 1000,
    "MaxBodyBytes": 65536,
    "ForwardAttempts": 3,
    "ForwardRetryDelayMs": 1000
  },
  "Scom": {
    "ManagementServer": "",
    "JeaEndpointName": "AIOpsScomReader"
  },
  "Directory": {
    "LdapServer": "",
    "DefaultSearchBase": "",
    "PageSize": 500,
    "TimeoutSeconds": 30
  },
  "Inventory": {
    "SqlConnectionString": "Server=<sql-server>;Database=AiOpsInventory;Integrated Security=true;TrustServerCertificate=true",
    "Servers": [ "<server1.contoso.local>", "<server2.contoso.local>" ],
    "NightlyHourLocal": 2,
    "EmbeddingEndpoint": "",
    "EmbeddingModel": "bge-m3",
    "EmbeddingDimensions": 1024,
    "QdrantEndpoint": "",
    "QdrantCollection": "aiops-inventory"
  },
  "Remoting": {
    "JeaEndpointName": "AIOpsReader",
    "WinRmPort": 5985,
    "MaxConcurrency": 20,
    "PerServerTimeoutSeconds": 30,
    "MaxSessions": 100,
    "OpenTimeoutSeconds": 15
  }
}
